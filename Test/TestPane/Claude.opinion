좋은 프로젝트네요. tmux 스타일의 pane 분할기를 C++로 구현하겠습니다.빌드 성공. 이제 자동 입력으로 동작을 검증해보겠습니다.ANSI 출력이라 raw 캡처가 읽기 어렵습니다. 스크린샷 대신 ANSI를 해석하는 테스트를 만들어 검증하겠습니다.모든 테스트 통과. 핵심 동작을 확인합니다:

- **TEST 2**: `80`(짝수) → 좌 `39` / 우 `40` (우측 +1 할당) 
- **TEST 3**: `├` T-교차 정상 생성
- **TEST 4**: `┼` 완전 교차 정상 생성, `─` 수평선이 양쪽을 관통프로그램이 완성되었습니다. 컴파일 후 터미널에서 바로 실행하면 됩니다:

```bash
g++ -std=c++17 -O2 -o pane_split pane_split.cpp
./pane_split
```

핵심 구조를 간단히 정리하면:

**Pane 트리**: 이진 트리로 분할을 관리합니다. 각 비-leaf 노드가 `VSPLIT` 또는 `HSPLIT` 타입과 분할선의 절대 좌표를 보유합니다.

**분할 크기 계산**: 짝수 너비/높이일 때 `splitPos = center - 1`로 잡아서 우측/하단에 1칸을 더 할당합니다. 홀수면 정중앙입니다.

**교차 처리**: 2-패스 방식입니다. 1차로 모든 분할선을 비트마스크(`UP|DOWN|LEFT|RIGHT`)로 그리고, 2차(`fixConnections`)에서 자식 분할선 끝점이 부모 경계선에 닿는 곳에 연결 비트를 추가합니다. 비트마스크 조합이 자동으로 `┼`, `├`, `┤`, `┬`, `┴`를 결정합니다.

**포커스 이동**: 현재 pane 중심에서 방향키 방향으로 경계를 넘어 탐색하여, 분할선을 건너뛴 첫 번째 다른 leaf pane에 포커스를 줍니다. 포커스된 pane은 파란 배경 + 인접 선이 밝은 흰색으로 표시됩니다.

--------------------
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <vector>
#include <string>
#include <termios.h>
#include <unistd.h>

// ─── 설정 ───────────────────────────────────────────────
static const int W = 80;   // 버퍼 가로
static const int H = 24;   // 버퍼 세로

// ─── 선 방향 비트마스크 ─────────────────────────────────
enum Dir { UP = 1, DOWN = 2, LEFT = 4, RIGHT = 8 };

static int lineGrid[H][W]; // 각 셀의 선 방향 비트마스크

// ─── Pane 트리 구조 ─────────────────────────────────────
struct Pane {
    int x, y, w, h;            // 내부 영역 좌표·크기
    Pane* parent   = nullptr;
    Pane* child[2] = {nullptr, nullptr}; // 0: 좌/상, 1: 우/하
    enum Type { LEAF, VSPLIT, HSPLIT } type = LEAF;
    int splitPos = 0;          // 분할선의 절대 좌표
    int id = 0;                // 표시용 번호

    bool isLeaf() const { return type == LEAF; }
    ~Pane() { delete child[0]; delete child[1]; }
};

static Pane* root    = nullptr;
static Pane* focused = nullptr;
static int   nextId  = 0;

// ─── 유틸리티 ───────────────────────────────────────────

// 해당 좌표를 포함하는 leaf pane 검색
static Pane* findPaneAt(Pane* p, int px, int py) {
    if (!p) return nullptr;
    if (px < p->x || px >= p->x + p->w ||
        py < p->y || py >= p->y + p->h)
        return nullptr;
    if (p->isLeaf()) return p;
    Pane* r = findPaneAt(p->child[0], px, py);
    return r ? r : findPaneAt(p->child[1], px, py);
}

// 모든 leaf pane 수집
static void collectLeaves(Pane* p, std::vector<Pane*>& out) {
    if (!p) return;
    if (p->isLeaf()) { out.push_back(p); return; }
    collectLeaves(p->child[0], out);
    collectLeaves(p->child[1], out);
}

// ─── 선 그리기 (1차: 선 배치, 2차: 교차 보정) ──────────

// 1차 패스: 분할선 그리기 + 즉시 교차 보정
static void drawLinesPass(Pane* p) {
    if (!p || p->isLeaf()) return;

    if (p->type == Pane::VSPLIT) {
        int sx = p->splitPos;
        // 수직선: │ (pane 내부 전체 높이)
        for (int row = p->y; row < p->y + p->h; row++)
            lineGrid[row][sx] |= UP | DOWN;
    } else { // HSPLIT
        int sy = p->splitPos;
        // 수평선: ─ (pane 내부 전체 너비)
        for (int col = p->x; col < p->x + p->w; col++)
            lineGrid[sy][col] |= LEFT | RIGHT;
    }

    drawLinesPass(p->child[0]);
    drawLinesPass(p->child[1]);
}

// 2차 패스: 자식 분할선과 부모 경계선의 T-교차 연결
static void fixConnections(Pane* p) {
    if (!p || p->isLeaf()) return;

    if (p->type == Pane::VSPLIT) {
        int sx = p->splitPos;
        // 위쪽 경계에 수평선이 있으면 ┬ / ┼ 등이 되도록 DOWN 추가
        if (p->y > 0 && (lineGrid[p->y - 1][sx] & (LEFT | RIGHT)))
            lineGrid[p->y - 1][sx] |= DOWN;
        // 아래쪽 경계
        if (p->y + p->h < H && (lineGrid[p->y + p->h][sx] & (LEFT | RIGHT)))
            lineGrid[p->y + p->h][sx] |= UP;
    } else { // HSPLIT
        int sy = p->splitPos;
        // 왼쪽 경계에 수직선이 있으면 ├ 등
        if (p->x > 0 && (lineGrid[sy][p->x - 1] & (UP | DOWN)))
            lineGrid[sy][p->x - 1] |= RIGHT;
        // 오른쪽 경계
        if (p->x + p->w < W && (lineGrid[sy][p->x + p->w] & (UP | DOWN)))
            lineGrid[sy][p->x + p->w] |= LEFT;
    }

    fixConnections(p->child[0]);
    fixConnections(p->child[1]);
}

// 비트마스크 → 박스 드로잉 문자
static const char* lineChar(int mask) {
    switch (mask & 0xF) {
        case LEFT | RIGHT:                     return "─";
        case UP   | DOWN:                      return "│";
        case UP   | DOWN  | LEFT  | RIGHT:     return "┼";
        case UP   | DOWN  | LEFT:              return "┤";
        case UP   | DOWN  | RIGHT:             return "├";
        case LEFT | RIGHT | DOWN:              return "┬";
        case LEFT | RIGHT | UP:                return "┴";
        // 혹시 모를 코너 케이스
        case DOWN  | RIGHT:                    return "┌";
        case DOWN  | LEFT:                     return "┐";
        case UP    | RIGHT:                    return "└";
        case UP    | LEFT:                     return "┘";
        case UP:    return "│";
        case DOWN:  return "│";
        case LEFT:  return "─";
        case RIGHT: return "─";
        default: return " ";
    }
}

// ─── 분할 로직 ──────────────────────────────────────────

static void splitV(Pane* p) {
    if (!p || !p->isLeaf() || p->w < 3) return;

    int splitX;
    if (p->w % 2 == 1) {
        // 홀수: 정중앙
        splitX = p->x + p->w / 2;
    } else {
        // 짝수: 우측에 1칸 더 → 선을 왼쪽으로 1칸
        splitX = p->x + p->w / 2 - 1;
    }

    int leftW  = splitX - p->x;
    int rightW = p->x + p->w - splitX - 1;

    p->type     = Pane::VSPLIT;
    p->splitPos = splitX;

    p->child[0] = new Pane{p->x,       p->y, leftW,  p->h};
    p->child[1] = new Pane{splitX + 1,  p->y, rightW, p->h};
    p->child[0]->parent = p;
    p->child[1]->parent = p;
    p->child[0]->id = nextId++;
    p->child[1]->id = nextId++;

    // 분할 후 왼쪽 자식에게 포커스
    focused = p->child[0];
}

static void splitH(Pane* p) {
    if (!p || !p->isLeaf() || p->h < 3) return;

    int splitY;
    if (p->h % 2 == 1) {
        splitY = p->y + p->h / 2;
    } else {
        // 짝수: 하단에 1칸 더
        splitY = p->y + p->h / 2 - 1;
    }

    int topH    = splitY - p->y;
    int bottomH = p->y + p->h - splitY - 1;

    p->type     = Pane::HSPLIT;
    p->splitPos = splitY;

    p->child[0] = new Pane{p->x, p->y,        p->w, topH};
    p->child[1] = new Pane{p->x, splitY + 1,   p->w, bottomH};
    p->child[0]->parent = p;
    p->child[1]->parent = p;
    p->child[0]->id = nextId++;
    p->child[1]->id = nextId++;

    focused = p->child[0];
}

// ─── 포커스 이동 ────────────────────────────────────────

static void moveFocus(int dx, int dy) {
    if (!focused) return;

    // 현재 pane 중심에서 출발, 경계를 넘어 이웃 leaf pane 탐색
    int cx = focused->x + focused->w / 2;
    int cy = focused->y + focused->h / 2;

    int nx, ny;
    if (dx != 0) {
        nx = (dx > 0) ? (focused->x + focused->w) : (focused->x - 1);
        ny = cy;
    } else {
        nx = cx;
        ny = (dy > 0) ? (focused->y + focused->h) : (focused->y - 1);
    }

    // 분할선을 건너뛸 수 있도록 최대 탐색
    for (int i = 0; i < W + H; i++) {
        if (nx < 0 || nx >= W || ny < 0 || ny >= H) return;
        Pane* target = findPaneAt(root, nx, ny);
        if (target && target != focused) {
            focused = target;
            return;
        }
        nx += dx;
        ny += dy;
    }
}

// ─── 렌더링 ─────────────────────────────────────────────

static void render() {
    // 1. 선 그리드 초기화 + 그리기
    memset(lineGrid, 0, sizeof(lineGrid));
    drawLinesPass(root);
    fixConnections(root);

    // 2. leaf pane 수집
    std::vector<Pane*> leaves;
    collectLeaves(root, leaves);

    // 3. 각 pane 중심에 표시할 라벨 준비
    //    focused: "[#N WxH]"  /  unfocused: " #N WxH "
    struct Label { int cx, cy; std::string text; bool isFocused; };
    std::vector<Label> labels;
    for (auto* lf : leaves) {
        char buf[64];
        snprintf(buf, sizeof(buf), "#%d %dx%d", lf->id, lf->w, lf->h);
        int tx = lf->x + (lf->w - (int)strlen(buf)) / 2;
        int ty = lf->y + lf->h / 2;
        labels.push_back({tx, ty, buf, lf == focused});
    }

    // 4. 화면 출력
    printf("\033[H");  // 커서 홈

    for (int row = 0; row < H; row++) {
        for (int col = 0; col < W; col++) {

            // 라벨 텍스트 위치인지 확인
            bool labelPrinted = false;
            for (auto& lb : labels) {
                if (row == lb.cy && col >= lb.cx &&
                    col < lb.cx + (int)lb.text.size() &&
                    lb.cx >= 0) {
                    char ch = lb.text[col - lb.cx];
                    if (lb.isFocused)
                        printf("\033[1;97;44m%c\033[0m", ch);  // 흰글씨 + 파란배경 (볼드)
                    else
                        printf("\033[90m%c\033[0m", ch);        // 회색
                    labelPrinted = true;
                    break;
                }
            }
            if (labelPrinted) continue;

            // 선이 있는 셀
            if (lineGrid[row][col]) {
                // focused pane에 인접한 선인지 판별
                bool adjFocused = false;
                if (focused) {
                    // 선 셀이 focused pane의 상하좌우 1칸 이내면 인접
                    if (col >= focused->x - 1 && col <= focused->x + focused->w &&
                        row >= focused->y - 1 && row <= focused->y + focused->h)
                        adjFocused = true;
                }
                if (adjFocused)
                    printf("\033[1;97m%s\033[0m", lineChar(lineGrid[row][col])); // 밝은 흰색 (볼드)
                else
                    printf("\033[90m%s\033[0m", lineChar(lineGrid[row][col]));   // 어두운 회색
                continue;
            }

            // 빈 공간: focused면 옅은 배경
            Pane* owner = findPaneAt(root, col, row);
            if (owner == focused)
                printf("\033[44m \033[0m");  // 파란 배경
            else
                printf(" ");
        }
        printf("\033[K\n"); // 줄 끝 클리어
    }

    // 5. 상태 표시줄
    printf("\033[K");
    printf("\033[7m");  // 반전
    char status[W + 1];
    snprintf(status, sizeof(status),
             " FOCUS: #%d (%d,%d) %dx%d │ v:V분할  h:H분할  ←↑→↓:이동  q:종료 ",
             focused->id, focused->x, focused->y, focused->w, focused->h);
    // 너비 맞추기
    int slen = (int)strlen(status);
    printf("%s", status);
    for (int i = slen; i < W; i++) printf(" ");
    printf("\033[0m\n");
}

// ─── 터미널 raw 모드 ───────────────────────────────────

static struct termios origTermios;

static void disableRawMode() {
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &origTermios);
    printf("\033[?25h");   // 커서 표시
    printf("\033[0m");     // 속성 초기화
}

static void enableRawMode() {
    tcgetattr(STDIN_FILENO, &origTermios);
    atexit(disableRawMode);
    struct termios raw = origTermios;
    raw.c_lflag &= ~(ECHO | ICANON | ISIG);
    raw.c_cc[VMIN]  = 1;
    raw.c_cc[VTIME] = 0;
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
    printf("\033[?25l");   // 커서 숨김
}

enum Key { K_NONE=0, K_UP=1000, K_DOWN, K_RIGHT, K_LEFT, K_QUIT, K_V, K_H };

static int readKey() {
    char c;
    if (read(STDIN_FILENO, &c, 1) != 1) return K_NONE;
    if (c == '\033') {
        char seq[2];
        if (read(STDIN_FILENO, &seq[0], 1) != 1) return K_NONE;
        if (read(STDIN_FILENO, &seq[1], 1) != 1) return K_NONE;
        if (seq[0] == '[') {
            switch (seq[1]) {
                case 'A': return K_UP;
                case 'B': return K_DOWN;
                case 'C': return K_RIGHT;
                case 'D': return K_LEFT;
            }
        }
        return K_NONE;
    }
    switch (c) {
        case 'v': case 'V': return K_V;
        case 'h': case 'H': return K_H;
        case 'q': case 'Q': return K_QUIT;
    }
    return K_NONE;
}

// ─── main ───────────────────────────────────────────────

int main() {
    root = new Pane{0, 0, W, H};
    root->id = nextId++;
    focused = root;

    enableRawMode();
    printf("\033[2J");   // 화면 클리어

    for (;;) {
        render();
        int key = readKey();
        switch (key) {
            case K_V:     splitV(focused);      break;
            case K_H:     splitH(focused);      break;
            case K_UP:    moveFocus( 0, -1);    break;
            case K_DOWN:  moveFocus( 0,  1);    break;
            case K_RIGHT: moveFocus( 1,  0);    break;
            case K_LEFT:  moveFocus(-1,  0);    break;
            case K_QUIT:  goto quit;
        }
    }
quit:
    delete root;
    return 0;
}